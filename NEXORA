-- ฟังก์ชันสร้างปุ่มเปิด-ปิด (Toggle)
local function createToggleRow(parentPage, titleTextStr)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(0, 330, 0, 40)
    row.BackgroundColor3 = Color3.fromRGB(22, 28, 38)
    row.Parent = parentPage

    local rowCorner = Instance.new("UICorner")
    rowCorner.CornerRadius = UDim.new(0, 6)
    rowCorner.Parent = row

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -110, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = titleTextStr
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 11
    label.Font = Enum.Font.GothamSemibold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 90, 0, 26)
    toggleBtn.Position = UDim2.new(1, -96, 0.5, -13)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(220, 40, 60)
    toggleBtn.Text = "ปิด"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextSize = 11
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.Parent = row

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = toggleBtn

    local isActive = false
    toggleBtn.Activated:Connect(function()
        isActive = not isActive
        if isActive then
            toggleBtn.Text = "เปิด"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        else
            toggleBtn.Text = "ปิด"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(220, 40, 60)
        end
    end)

    return toggleBtn, function() return isActive end
end

