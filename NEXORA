local espNameBtn, getEspName = createToggleRow(pageESP, "👁️ ESP ชื่อผู้เล่น")

local function clearAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Head") then
            local tag = p.Character.Head:FindFirstChild("NexoraTag")
            if tag then tag:Destroy() end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if getEspName() then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
                local head = p.Character.Head
                if not head:FindFirstChild("NexoraTag") then
                    local bgui = Instance.new("BillboardGui")
                    bgui.Name = "NexoraTag"
                    bgui.Size = UDim2.new(0, 200, 0, 50)
                    bgui.AlwaysOnTop = true
                    bgui.StudsOffset = Vector3.new(0, 2.5, 0)
                    
                    local txt = Instance.new("TextLabel", bgui)
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Text = p.Name
                    txt.TextColor3 = Color3.fromRGB(0, 170, 255)
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 20
                    txt.TextStrokeTransparency = 0
                    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    
                    bgui.Parent = head
                end
            end
        end
    else
        clearAllESP()
    end
end)

